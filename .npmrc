# pnpm 11 defaults to the isolated linker, which materialises every top-level
# dependency as a junction into node_modules/.pnpm. On this machine those
# junctions are not created reliably from a fresh clone: `pnpm install` reports
# success, but node_modules/<pkg> is left as an empty directory, so nothing is
# importable and the electron/esbuild install scripts never run (no Electron
# binary -> `pnpm build` and Playwright cannot start the app).
#
# The hoisted linker writes real directories instead of junctions, which
# installs correctly from a clean clone and is the documented pnpm fallback for
# filesystems that refuse reparse points.
node-linker=hoisted
