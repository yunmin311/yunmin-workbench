{
  "name": "yunmin-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Yunmin Workbench (product category: Agent Workbench) - projection layer over Governance/Overlay/Git/Harness",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.config.vnext.ts && vite build --config vite.config.compact.ts && vite build --config vite.island.config.ts && node scripts/copy-island.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "pnpm build && playwright test",
    "e2e:hermetic": "playwright test e2e/dual-project-hermetic.spec.ts e2e/cabinet-staging-sparse.spec.ts e2e/draft-close-flush.spec.ts e2e/reliability.spec.ts e2e/demo-workspace.spec.ts",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:win:dir": "pnpm build && electron-builder --win dir --x64 --publish never",
    "e2e:packaged": "playwright test e2e/packaged-windows-smoke.spec.ts",
    "docs:check": "node scripts/check-readme.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.7.2",
    "@noble/hashes": "1.7.1",
    "@xyflow/react": "^12.3.6",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "simple-git": "^3.36.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/dagre": "^0.7.52",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.yunmin.workbench",
    "productName": "Yunmin Workbench",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "artifactName": "Yunmin-Workbench-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
